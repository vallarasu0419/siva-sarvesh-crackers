{
  "name": "siva-sarvesh-crackers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Siva Sarvesh Crackers - Sivakasi crackers ordering website (Next.js Pages Router + MySQL/MariaDB)",
  "scripts": {
    "dev": "node --env-file=.env.local node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node --env-file=.env.local node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "test": "node --test",
    "db:setup": "node --env-file=.env.local scripts/setupDb.js",
    "db:generate-sql": "node scripts/generateSchemaSql.js",
    "seed": "node --env-file=.env.local scripts/seed.js",
    "seed:admin": "node --env-file=.env.local scripts/seedAdmin.js"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "mysql2": "^3.11.5",
    "next": "^15.1.0",
    "nodemailer": "^6.9.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
